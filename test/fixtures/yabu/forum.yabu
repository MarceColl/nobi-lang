defmodel Forum.Topic do
  id : Uuid
  title : String
  replies : Int = 0
end

defmodel Forum.Reply do
  id : Uuid
  topic : Uuid
  body : String
end

defmodel Forum.Threads.Model do
  topics : List<Forum.Topic>
  filter : String
  title : String
end

deftype Forum.Threads.Msg do
  Loaded(List<Forum.Topic>) | Filter(String) | Title(String) | Create | Created(Uuid) | Open(Uuid) | Settings
end

def Forum.Threads.init() : (Forum.Threads.Model, Cmd<Forum.Threads.Msg>) do
  (%Forum.Threads.Model{topics: [], filter: "", title: ""}, Cmd.store.list(Forum.Threads.Msg.Loaded))
end

def Forum.Threads.update(msg : Forum.Threads.Msg, model : Forum.Threads.Model) : (Forum.Threads.Model, Cmd<Forum.Threads.Msg>) do
  case msg do
    Forum.Threads.Msg.Loaded(topics) -> (%Forum.Threads.Model{model | topics: topics}, Cmd.none())
    Forum.Threads.Msg.Filter(text) -> (%Forum.Threads.Model{model | filter: text}, Cmd.none())
    Forum.Threads.Msg.Title(text) -> (%Forum.Threads.Model{model | title: text}, Cmd.none())
    Forum.Threads.Msg.Create ->
      if model.title == "" do
        (model, Cmd.none())
      else
        (%Forum.Threads.Model{model | title: ""}, Cmd.store.insert(%Forum.Topic{title: model.title, replies: 0}, Forum.Threads.Msg.Created))
      end
    Forum.Threads.Msg.Created(id) -> (model, Cmd.navigate(Forum.Post, id))
    Forum.Threads.Msg.Open(id) -> (model, Cmd.navigate(Forum.Post, id))
    Forum.Threads.Msg.Settings -> (model, Cmd.navigate(Forum.Settings))
  end
end

def Forum.Threads.view_topic(topic : Forum.Topic) : Html<Forum.Threads.Msg> do
  <li class="topic flex items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm transition hover:border-indigo-300 hover:shadow-md">
    <button class="flex-1 text-left font-medium text-slate-900 transition hover:text-indigo-600" on-click={Forum.Threads.Msg.Open(topic.id)}>{topic.title}</button>
    <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">{topic.replies}</span>
  </li>
end

def Forum.Threads.view(model : Forum.Threads.Model) : Html<Forum.Threads.Msg> do
  shown = List.filter(model.topics, fn (topic : Forum.Topic) -> String.contains(topic.title, model.filter) end)
  <main id="threads" class="mx-auto min-h-screen max-w-xl bg-slate-50 p-6 font-sans text-slate-800 antialiased">
    <header class="flex items-center justify-between pb-2">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Threads</h1>
      <button id="open-settings" class="rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900" on-click={Forum.Threads.Msg.Settings}>Settings</button>
    </header>
    <form id="new-thread" class="flex gap-2 py-4" on-submit={Forum.Threads.Msg.Create}>
      <input id="title" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" placeholder="New thread" value={model.title} on-change={Forum.Threads.Msg.Title} />
      <button id="create" class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 active:scale-95" type="submit">Create</button>
    </form>
    <input id="filter" class="mb-4 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" placeholder="Filter" value={model.filter} on-change={Forum.Threads.Msg.Filter} />
    <ul id="topics" class="space-y-2">{List.map(shown, Forum.Threads.view_topic)}</ul>
  </main>
end

defapp Forum.Threads

defmodel Forum.Post.Model do
  post_id : Uuid
  topic : Option<Forum.Topic>
  replies : List<Forum.Reply>
  draft : String
  error : String
end

deftype Forum.Post.Msg do
  Loaded(Option<Forum.Topic>) | Replies(List<Forum.Reply>) | Draft(String) | Reply | Posted(Result<(List<Uuid>, Int), String>) | Back
end

def Forum.Post.load(id : Uuid) : Cmd<Forum.Post.Msg> do
  Cmd.batch([Cmd.store.get(id, Forum.Post.Msg.Loaded), Cmd.store.list(Forum.Post.Msg.Replies)])
end

def Forum.Post.reply(topic : Uuid, body : String) : Cmd<Forum.Post.Msg> do
  Cmd.store.tx(
    fn (s : Store) ->
      case Store.get(s, topic) do
        Option.Some(t) -> ([Tx.insert(%Forum.Reply{topic: topic, body: body}), Tx.update(topic, %Forum.Topic{t | replies: t.replies + 1})], t.replies + 1)
        Option.None -> ([], 0)
      end
    end,
    Forum.Post.Msg.Posted
  )
end

def Forum.Post.init(id : Uuid) : (Forum.Post.Model, Cmd<Forum.Post.Msg>) do
  (%Forum.Post.Model{post_id: id, topic: Option.None, replies: [], draft: "", error: ""}, Forum.Post.load(id))
end

def Forum.Post.update(msg : Forum.Post.Msg, model : Forum.Post.Model) : (Forum.Post.Model, Cmd<Forum.Post.Msg>) do
  case msg do
    Forum.Post.Msg.Loaded(topic) -> (%Forum.Post.Model{model | topic: topic}, Cmd.none())
    Forum.Post.Msg.Replies(rows) -> (%Forum.Post.Model{model | replies: List.filter(rows, fn (r : Forum.Reply) -> r.topic == model.post_id end)}, Cmd.none())
    Forum.Post.Msg.Draft(text) -> (%Forum.Post.Model{model | draft: text}, Cmd.none())
    Forum.Post.Msg.Reply ->
      if model.draft == "" do
        (model, Cmd.none())
      else
        (%Forum.Post.Model{model | draft: "", error: ""}, Forum.Post.reply(model.post_id, model.draft))
      end
    Forum.Post.Msg.Posted(result) ->
      case result do
        Result.Ok(done) -> (model, Forum.Post.load(model.post_id))
        Result.Err(message) -> (%Forum.Post.Model{model | error: message}, Cmd.none())
      end
    Forum.Post.Msg.Back -> (model, Cmd.navigate(Forum.Threads))
  end
end

def Forum.Post.view_topic(topic : Option<Forum.Topic>) : Html<Forum.Post.Msg> do
  case topic do
    Option.Some(t) ->
      <header class="py-4">
        <h1 id="post-title" class="text-2xl font-bold tracking-tight text-slate-900">{t.title}</h1>
        <p class="mt-1 text-sm text-slate-500"><span id="reply-count" class="font-semibold text-indigo-600">{t.replies}</span><span class="ml-1">replies</span></p>
      </header>
    Option.None -> <h1 id="post-title" class="py-4 text-2xl font-bold text-slate-900">No such thread</h1>
  end
end

def Forum.Post.view(model : Forum.Post.Model) : Html<Forum.Post.Msg> do
  <main id="post" data-post={model.post_id} class="mx-auto min-h-screen max-w-xl bg-slate-50 p-6 font-sans text-slate-800 antialiased">
    <button id="back" class="-ml-3 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900" on-click={Forum.Post.Msg.Back}>All threads</button>
    {Forum.Post.view_topic(model.topic)}
    <ul id="replies" class="mb-4 space-y-2">{List.map(model.replies, fn (reply : Forum.Reply) -> <li class="reply rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm leading-relaxed shadow-sm">{reply.body}</li> end)}</ul>
    <form id="reply-form" class="flex gap-2" on-submit={Forum.Post.Msg.Reply}>
      <input id="draft" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" placeholder="Write a reply" value={model.draft} on-change={Forum.Post.Msg.Draft} />
      <button id="reply" class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 active:scale-95" type="submit">Reply</button>
    </form>
    <p id="post-error" class="mt-2 text-sm font-medium text-red-600">{model.error}</p>
  </main>
end

defapp Forum.Post

defmodel Forum.Settings.Model do
  name : String
  saved : Bool
end

deftype Forum.Settings.Msg do
  Name(String) | Save | Done
end

def Forum.Settings.init() : (Forum.Settings.Model, Cmd<Forum.Settings.Msg>) do
  (%Forum.Settings.Model{name: "", saved: false}, Cmd.none())
end

def Forum.Settings.update(msg : Forum.Settings.Msg, model : Forum.Settings.Model) : (Forum.Settings.Model, Cmd<Forum.Settings.Msg>) do
  case msg do
    Forum.Settings.Msg.Name(text) -> (%Forum.Settings.Model{model | name: text, saved: false}, Cmd.none())
    Forum.Settings.Msg.Save -> (%Forum.Settings.Model{model | saved: true}, Cmd.none())
    Forum.Settings.Msg.Done -> (model, Cmd.navigate(Forum.Threads))
  end
end

def Forum.Settings.view(model : Forum.Settings.Model) : Html<Forum.Settings.Msg> do
  <main id="settings" class="mx-auto min-h-screen max-w-xl bg-slate-50 p-6 font-sans text-slate-800 antialiased">
    <h1 class="pb-4 text-3xl font-bold tracking-tight text-slate-900">Settings</h1>
    <div class="space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <input id="name" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" placeholder="Display name" value={model.name} on-change={Forum.Settings.Msg.Name} />
      <div class="flex items-center gap-3">
        <button id="save" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 active:scale-95" on-click={Forum.Settings.Msg.Save}>Save</button>
        <span id="saved" class="text-sm font-medium text-emerald-600">{if model.saved do "Saved" else "" end}</span>
        <button id="done" class="ml-auto rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900" on-click={Forum.Settings.Msg.Done}>Done</button>
      </div>
    </div>
  </main>
end

defapp Forum.Settings

defroutes Forum do
  "/" -> Forum.Threads
  "/post/:id" -> Forum.Post
  "/settings" -> Forum.Settings
end
